# Cabeceras de Cloudflare (Pages / Workers static assets)
# Las reglas se acumulan: "! Cache-Control" quita el valor heredado de /*.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # HTML y demás rutas: siempre revalidar
  Cache-Control: public, max-age=0, must-revalidate

# Assets con hash de contenido: inmutables
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Archivos de public/ sin hash en el nombre: caché de 1 día
/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
