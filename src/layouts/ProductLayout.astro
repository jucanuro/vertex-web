---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/templates/PageHero.astro';
import CTABlock from '../components/templates/CTABlock.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ProductLogo from '../components/brand/ProductLogo.astro';
import Icon from '../components/ui/Icon.astro';
import ScreenshotShowcase from '../components/ui/ScreenshotShowcase.astro';
import { getImage } from 'astro:assets';
import { resolveScreenshots, shotConfig } from '../lib/screenshots';
import { products, type Product } from '../data/products';
import { hasProductLogo } from '../lib/product-logo';
import { seo } from '../data/seo';
import { company, whatsappLink } from '../data/company';

interface Props {
  id: keyof typeof products;
}
const { id } = Astro.props;
const p: Product = products[id];
const meta = seo[p.slug as keyof typeof seo];
const logoOk = hasProductLogo(p);
const operating = id === 'qhalisys';
const wa = whatsappLink(`Hola, quiero conocer ${p.name}`);

// URLs absolutas de las versiones optimizadas (mayor ancho de cada captura, WebP)
const shots = resolveScreenshots(p.screenshots);
const screenshotUrls = await Promise.all(
  shots.map(async (s) => {
    const { widths, quality } = shotConfig[s.kind];
    const img = await getImage({ src: s.image, width: widths[widths.length - 1], format: 'webp', quality });
    return new URL(img.src, Astro.site).href;
  }),
);
// Sección inferior: una captura distinta a la mejor ubicada del hero (cada una aparece 2 veces como máximo)
const lower = id === 'qhalisys' ? [0] : [1];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: p.description,
  url: new URL(p.slug, Astro.site).href,
  logo: new URL(p.logo.light, Astro.site).href,
  provider: { '@type': 'Organization', name: company.name, url: Astro.site!.origin },
  ...(screenshotUrls.length > 0 && { screenshot: screenshotUrls }),
};
---

<BaseLayout title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <PageHero
    eyebrow="Plataforma propia"
    title={logoOk ? p.tagline : `${p.name}: ${p.tagline}`}
    srTitlePrefix={logoOk ? `${p.name}: ` : undefined}
    subtitle={p.body}
    breadcrumbs={[{ label: 'Servicios', href: '/servicios/' }, { label: 'Vertex Platforms', href: '/servicios/sistemas-saas/' }, { label: p.name, icon: p.icon }]}
  >
    <Fragment slot="logo">{logoOk && <ProductLogo product={id} variant="full" class="product-hero-logo" eager />}</Fragment>
    {operating && <Badge>En operación</Badge>}
    <Button href={wa} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</Button>
    <ScreenshotShowcase slot="visual" screenshots={p.screenshots} name={p.name} size="large" eager class="mt-6" />
  </PageHero>

  <Section bg="none">
    <div class="grid gap-(--card-gap) md:grid-cols-2">
      <Reveal class="h-full">
        <GlassCard as="div" class="flex h-full flex-col gap-3">
          <h2 class="text-h3">Para quién es</h2>
          <p class="text-text-muted">{p.audience}</p>
        </GlassCard>
      </Reveal>
      <Reveal delay={100} class="h-full">
        <GlassCard as="div" class="flex h-full flex-col gap-3">
          <h2 class="text-h3">Qué resuelve</h2>
          <p class="text-text-muted">{p.solves}</p>
        </GlassCard>
      </Reveal>
    </div>
    {p.status && <p class="mt-6 text-sm text-text-muted">Estado: {p.status}.</p>}
  </Section>

  <Section bg="alt">
    <Reveal><SectionHeading eyebrow={p.name} title="Funciones" /></Reveal>
    <ul class="mt-(--heading-gap) grid gap-(--card-gap) sm:grid-cols-2">
      {
        p.features.map((f, i) => (
          <li>
            <Reveal delay={i * 80} class="h-full">
              <GlassCard as="div" class="flex h-full items-start gap-3 !p-5">
                <span class="mt-0.5 flex-none text-primary"><Icon svg={'<path d="m5 12.5 4.5 4.5L19 7.5"/>'} class="size-5" /></span>
                <span>{f}</span>
              </GlassCard>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section bg="none">
    <ScreenshotShowcase screenshots={p.screenshots} name={p.name} size="default" only={lower} decorative />
  </Section>

  <CTABlock audience="negocios" title={`¿Quieres conocer ${p.name}? Escríbenos.`} text="Te respondemos por WhatsApp." whatsapp={wa} />
</BaseLayout>

<style is:global>
  .product-hero-logo {
    height: clamp(56px, 7vw, 72px);
    width: auto;
  }
</style>
