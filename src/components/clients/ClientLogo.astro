---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { Client } from '../../data/clients';
import { getClientLogo } from '../../lib/client-logos';

interface Props {
  client: Client;
  /** strip: franja de la home (solo ficha). grid: listas grandes, con nombre y sector debajo. */
  variant?: 'strip' | 'grid';
  class?: string;
}
const { client, variant = 'strip', class: className } = Astro.props;

const icons = {
  institution: '<path d="M3 9.5 12 4l9 5.5"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"/>',
  building: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7.5h2M13 7.5h2M9 11.5h2M13 11.5h2M10 21v-4h4v4"/>',
};
const icon = client.sector === 'Educación superior' ? icons.institution : icons.building;

// Caja del logo dentro de la ficha (px)
const box = variant === 'grid' ? { w: 140, h: 56 } : { w: 140, h: 48 };

const raster = getClientLogo(client.logo);
let w1 = 0;
let w2 = 0;
if (raster) {
  // Ancho renderizado: cabe en la caja (object-fit: contain) y nunca supera el tamaño real; el 2x tampoco
  const scale = Math.min(box.w / raster.width, box.h / raster.height, 1);
  w1 = Math.max(1, Math.round(raster.width * scale));
  w2 = Math.min(raster.width, w1 * 2);
}
const svgLogo = !raster && client.logo?.startsWith('/') ? client.logo : undefined;
---

<div class:list={['client', `client--${variant}`, className]} title={client.name}>
  <div class="chip" style={`--box-w:${box.w}px;--box-h:${box.h}px`}>
    {
      raster ? (
        <Picture
          src={raster}
          alt={client.name}
          width={w1}
          widths={w2 > w1 ? [w1, w2] : [w1]}
          sizes={`${w1}px`}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="lazy"
          decoding="async"
          class="client-img"
          pictureAttributes={{ class: 'client-pic' }}
        />
      ) : svgLogo && client.logoSize ? (
        // Ficha blanca en ambos temas: siempre la versión para fondo claro
        <picture class="client-pic">
          <img src={svgLogo} alt={client.name} {...client.logoSize} loading="lazy" decoding="async" class="client-img" />
        </picture>
      ) : (
        <div class="fallback">
          <Icon svg={icon} class="size-6" />
          <span class="fallback-name">{client.name}</span>
        </div>
      )
    }
  </div>
  {
    variant === 'grid' && (
      <p class="meta">
        <span class="meta-name">{client.name}</span>
        <span class="meta-sector">{client.sector}</span>
      </p>
    )
  }
</div>

<style>
  .client {
    width: 100%;
    max-width: 172px;
    margin-inline: auto;
  }
  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    height: calc(var(--box-h) + 24px);
    padding: 12px;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid rgb(15 23 42 / 0.08);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .client:hover .chip {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px rgb(31 95 184 / 0.35);
  }
  .chip :global(.client-pic) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, var(--box-w));
    height: var(--box-h);
    max-height: var(--box-h);
  }
  .chip :global(.client-img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--box-h);
    object-fit: contain;
    object-position: center;
  }
  .fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    height: var(--box-h);
    color: #475569;
    text-align: center;
  }
  .fallback-name {
    font-size: 0.75rem;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .client--grid .fallback-name {
    display: none;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0.625rem 0 0;
    text-align: center;
  }
  .meta-name {
    font-size: 0.8125rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--c-text);
  }
  .meta-sector {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--c-text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
    .client:hover .chip {
      transform: none;
      box-shadow: none;
    }
  }
</style>
