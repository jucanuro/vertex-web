---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface QA {
  question: string;
  answer: string;
}
interface Props {
  items: QA[];
  title?: string;
}
const { items, title = 'Preguntas frecuentes' } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};
---

{
  items.length > 0 && (
    <Section bg="none">
      <SectionHeading title={title} />
      <div class="mt-8 flex max-w-3xl flex-col gap-3">
        {items.map((q) => (
          <details class="faq glass rounded-lg px-5 py-4">
            <summary class="cursor-pointer font-semibold">{q.question}</summary>
            <p class="mt-3 text-text-muted">{q.answer}</p>
          </details>
        ))}
      </div>
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </Section>
  )
}
