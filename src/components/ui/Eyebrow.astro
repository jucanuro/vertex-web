---
interface Props {
  color?: string;
  class?: string;
}
const { color = 'var(--color-primary)', class: className } = Astro.props;
---

<p class:list={['eyebrow', className]} style={`--dot:${color}`}>
  <span class="dot" aria-hidden="true"></span><slot />
</p>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--dot);
    box-shadow: 0 0 8px var(--dot);
  }
</style>
