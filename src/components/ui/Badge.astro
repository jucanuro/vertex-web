---
interface Props {
  variant?: 'default' | 'soon' | 'tech';
  class?: string;
}
const { variant = 'default', class: className } = Astro.props;
---

<span class:list={['badge', `badge-${variant}`, className]}>
  {variant === 'soon' && !Astro.slots.has('default') ? 'Próximamente' : <slot />}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  .badge-default {
    color: var(--c-text);
    background: color-mix(in srgb, var(--c-primary-bright) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-primary-bright) 30%, transparent);
  }
  .badge-soon {
    color: var(--accent-chain);
    background: color-mix(in srgb, var(--accent-chain-bright) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-chain-bright) 35%, transparent);
  }
  .badge-tech {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--c-text-muted);
    background: var(--tint);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
</style>
