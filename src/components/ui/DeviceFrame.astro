---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shotConfig } from '../../lib/screenshots';

interface Props {
  variant: 'browser' | 'phone';
  /** Sin imagen se muestra el contenido del slot (p. ej. ImagePlaceholder) */
  image?: ImageMetadata;
  /** Proporción cuando no hay imagen */
  ratio?: string;
  /** Descripción de lo que muestra la captura; "" si es decorativa (duplicada) */
  alt?: string;
  /** Texto de adorno en la barra del navegador (solo el nombre del producto, sin dominio) */
  label?: string;
  /** Primera imagen visible sin scroll: carga inmediata (sin prioridad alta, para no competir con el título) */
  eager?: boolean;
  /** Atributo sizes del srcset: el ancho real al que se pinta la imagen */
  sizes?: string;
  class?: string;
}
const { variant, image, ratio, alt = '', label, eager = false, sizes = '100vw', class: className } = Astro.props;
const kind = variant === 'browser' ? 'desktop' : 'mobile';
const { widths, quality } = shotConfig[kind];
// AVIF con respaldo WebP (nunca PNG: pesaría cientos de KB)
const load = eager ? { loading: 'eager' as const, fetchpriority: 'low' as const } : { loading: 'lazy' as const };
---

<figure class:list={['frame', `frame-${variant}`, className]} style={`--ratio:${image ? `${image.width} / ${image.height}` : (ratio ?? (variant === 'phone' ? '9 / 19.5' : '16 / 10'))}`}>
  {
    variant === 'browser' && (
      <div class="bar" aria-hidden="true">
        <span class="dots"><i /><i /><i /></span>
        {label && <span class="url">{label}</span>}
      </div>
    )
  }
  {variant === 'phone' && <span class="notch" aria-hidden="true" />}
  <div class="screen">
    {!image && <slot />}
    {image && <Picture
      src={image}
      alt={alt}
      widths={[...widths]}
      sizes={sizes}
      formats={['avif']}
      fallbackFormat="webp"
      quality={quality}
      width={image.width}
      height={image.height}
      decoding="async"
      {...load}
    />}
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    position: relative;
    background: var(--c-surface);
  }
  .screen {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--c-bg-alt);
  }
  /* La imagen conserva su proporción: la caja ya tiene la misma, así que cover no recorta nada */
  .screen :global(picture) {
    display: contents;
  }
  .screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Navegador ── */
  .frame-browser {
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-glow-lg), var(--float-shadow);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2rem;
    padding-inline: 0.75rem;
    background: var(--c-bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .dots {
    display: flex;
    gap: 0.375rem;
  }
  .dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--c-text-muted);
    opacity: 0.45;
  }
  .url {
    flex: 1;
    max-width: 16rem;
    padding: 0.125rem 0.75rem;
    border-radius: 9999px;
    background: var(--tint);
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Celular ── */
  .frame-phone {
    border: 6px solid var(--bezel);
    border-radius: 36px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--bezel-ring),
      var(--shadow-glow-md),
      var(--float-shadow);
  }
  .frame-phone .screen {
    border-radius: 30px;
  }
  .notch {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    left: 50%;
    width: 22%;
    height: 0.375rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: var(--bezel);
  }
</style>
