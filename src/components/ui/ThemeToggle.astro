---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Estado inicial (oscuro); theme.ts lo sincroniza si el tema activo es otro. El ícono lo decide el CSS por data-theme.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar a tema claro"
  aria-pressed="true"
  title="Cambiar a tema claro"
  class:list={['theme-toggle', className]}
>
  <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 0.5rem;
    color: var(--c-text-muted);
    transition: color 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--c-text);
  }
  .theme-toggle svg {
    width: 1.375rem;
    height: 1.375rem;
  }
  .i-moon {
    display: none;
  }
  :global([data-theme='light']) .i-sun {
    display: none;
  }
  :global([data-theme='light']) .i-moon {
    display: block;
  }
</style>

<script>
  import '../../scripts/theme';
</script>
