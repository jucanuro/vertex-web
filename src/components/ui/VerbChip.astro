---
import Icon from './Icon.astro';
import { verbs, type Verb } from '../../data/services';

interface Props {
  verb: Verb;
  class?: string;
}
const { verb, class: className } = Astro.props;

const icons: Record<Verb, string> = {
  piensa: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17v4M17 19h4"/>',
  protege: '<path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  escala: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  base: '<rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/><rect x="8.5" y="4" width="7" height="7" rx="1"/>',
};
const { label, color } = verbs[verb];
---

<span class:list={['verb-chip', className]} style={`--verb:${color}`}>
  <Icon svg={icons[verb]} class="size-3.5" />
  {label}
</span>

<style>
  .verb-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem 0.2rem 0.5rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--verb);
    background: color-mix(in srgb, var(--verb) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--verb) 35%, transparent);
  }
</style>
