---
interface Props {
  /** Contenido interno de un <svg viewBox="0 0 24 24"> de trazo */
  svg: string;
  class?: string;
}
const { svg, class: className = 'size-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={svg}
/>
