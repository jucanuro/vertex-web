---
interface Props {
  bg?: 'none' | 'grid' | 'aurora' | 'alt';
  /** Relleno vertical por lado: sm (bandas), md (normal), lg (Philosophy, CTA final) */
  size?: 'sm' | 'md' | 'lg';
  id?: string;
  class?: string;
}
const { bg = 'none', size = 'md', id, class: className } = Astro.props;
---

<section id={id} class:list={['section relative isolate', `section--${bg}`, `section--${size}`, bg === 'alt' && 'bg-bg-900', className]}>
  {
    bg === 'grid' && (
      <div
        class="bg-grid absolute inset-0 -z-10"
        style="mask-image:radial-gradient(ellipse at center,#000 30%,transparent 80%);-webkit-mask-image:radial-gradient(ellipse at center,#000 30%,transparent 80%)"
        aria-hidden="true"
      />
    )
  }
  {bg === 'aurora' && <div class="bg-aurora absolute inset-0 -z-10" aria-hidden="true" />}
  <div class="section-inner mx-auto w-full max-w-[1200px] px-5 sm:px-8">
    <slot />
  </div>
</section>
