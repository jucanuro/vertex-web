---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { navigation, megaColumns, type Locale } from '../../data/navigation';
import { whatsappUrl } from '../../data/company';

interface Props {
  lang?: Locale;
}
const { lang = 'es' } = Astro.props;
const nav = navigation[lang];
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
const paths = nav.main.filter((i) => i.kind === 'link' && i.path);
const mega = nav.main.find((i) => i.kind === 'mega');
---

{/* Nota: el display se controla aquí (CSS con alcance) y no con `lg:hidden`, que perdería contra él. */}
<div id="menu-movil" data-menu-panel role="dialog" aria-modal="true" aria-label="Menú" class="mmenu">
  <div data-menu-inner class="mx-auto flex w-full max-w-xl flex-1 flex-col gap-6">
    <nav aria-label="Móvil" class="flex flex-col gap-6">
      <ul class="flex flex-col gap-3">
        {
          paths.map((item) =>
            item.kind === 'link' && (
              <li>
                <a
                  href={item.href}
                  data-path={item.path}
                  aria-current={active(item.href) ? 'page' : undefined}
                  class="path-card flex min-h-24 items-center justify-between gap-4 rounded-xl p-5"
                >
                  <span class="flex flex-col gap-1">
                    <span class="font-display text-xl font-extrabold">{item.label}</span>
                    <span class="text-sm opacity-85">{item.blurb}</span>
                  </span>
                  <span aria-hidden="true" class="text-xl">→</span>
                </a>
              </li>
            ),
          )
        }
      </ul>

      <ul class="flex flex-col">
        {
          mega && mega.kind === 'mega' && (
            <li class="border-b border-(--border)">
              <button
                type="button"
                data-menu-acc
                aria-expanded="false"
                aria-controls="menu-servicios"
                class="flex min-h-14 w-full items-center justify-between py-3 font-display text-2xl font-extrabold"
              >
                {mega.label}
                <svg viewBox="0 0 24 24" class="chev size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <div id="menu-servicios" hidden class="flex flex-col gap-5 pb-5">
                {megaColumns.map((col) => (
                  <div>
                    <p class="mb-1 font-mono text-xs font-medium tracking-[0.18em] uppercase" style={`color:${col.color}`}>
                      {col.title}
                    </p>
                    <ul class="flex flex-col">
                      {col.items.map((s) => {
                        const inner = (
                          <>
                            <span class="mt-[0.45rem] size-2 flex-none rounded-full" style={`background:${s.accent}`} aria-hidden="true" />
                            <span class="flex flex-col">
                              <span class="flex flex-wrap items-center gap-2 text-sm font-semibold">
                                {s.brand}
                                {s.status === 'proximamente' && <Badge variant="soon" />}
                              </span>
                              <span class="text-xs text-text-muted">{s.descriptor}</span>
                            </span>
                          </>
                        );
                        return (
                          <li>
                            {s.status === 'proximamente' ? (
                              <div class="flex min-h-11 gap-3 py-2 opacity-80">{inner}</div>
                            ) : (
                              <a href={s.slug} aria-current={active(s.slug) ? 'page' : undefined} class="flex min-h-11 gap-3 py-2">
                                {inner}
                              </a>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          )
        }
        {
          nav.mobileLinks.map((item) => (
            <li class="border-b border-(--border)">
              <a
                href={item.href}
                aria-current={active(item.href) ? 'page' : undefined}
                class="flex min-h-14 items-center py-3 font-display text-2xl font-extrabold aria-[current=page]:text-primary"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-auto flex flex-col gap-3 pt-4">
      <Button href={nav.cta.href} size="lg" class="w-full">{nav.cta.label}</Button>
      <Button href={whatsappUrl} variant="secondary" size="lg" class="w-full" target="_blank" rel="noopener noreferrer">
        WhatsApp
      </Button>
      <div class="flex items-center justify-center gap-3">
        <p class="text-center font-mono text-xs text-text-muted" aria-label="Idioma">
          <span class="text-text" aria-current="true">ES</span> /
          <span class="cursor-not-allowed opacity-70" aria-disabled="true" title="Próximamente">EN</span>
        </p>
        <ThemeToggle />
      </div>
    </div>
  </div>
</div>

<style>
  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(var(--header-h) + env(safe-area-inset-top) + 1rem) calc(1.25rem + env(safe-area-inset-right))
      calc(1.5rem + env(safe-area-inset-bottom)) calc(1.25rem + env(safe-area-inset-left));
    background: var(--menu-bg);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 0s linear 220ms;
  }
  .mmenu[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (min-width: 1024px) {
    .mmenu {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mmenu {
      transition: none;
      transform: none;
    }
  }
  .path-card[data-path='negocios'] {
    color: var(--on-negocios);
    background: var(--gradient-negocios);
  }
  .path-card[data-path='empresas'] {
    color: var(--on-empresas);
    background: var(--gradient-empresas);
  }
  .chev {
    transition: transform 0.2s ease;
  }
  [aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
</style>

<style is:global>
  /* Bloqueo de scroll sin salto: --sbw compensa el ancho de la barra que desaparece */
  html[data-menu-open] {
    overflow: hidden;
    padding-right: var(--sbw, 0px);
  }
  html[data-menu-open] [data-header] {
    padding-right: var(--sbw, 0px);
  }
</style>
