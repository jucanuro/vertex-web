---
import Logo from '../brand/Logo.astro';
import Button from '../ui/Button.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MegaMenuContent from './MegaMenuContent.astro';
import MobileMenu from './MobileMenu.astro';
import { navigation, type Locale } from '../../data/navigation';

interface Props {
  lang?: Locale;
}
const { lang = 'es' } = Astro.props;
const nav = navigation[lang];
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---

<header data-header class="header fixed inset-x-0 top-0 z-50">
  <div class="relative mx-auto flex h-(--header-h) max-w-[1200px] items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" aria-label="Vertex Quant Labs, inicio" class="relative z-10 rounded-md">
      <Logo class="text-[0.9rem] sm:text-base" />
    </a>

    <nav aria-label="Principal" class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-1">
        {
          nav.main.map((item) =>
            item.kind === 'mega' ? (
              <li data-dropdown class="flex h-full items-center">
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls="mega-servicios"
                  aria-current={active(item.href) ? 'page' : undefined}
                  class="nav-link flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:text-text aria-expanded:text-text aria-[current=page]:text-primary"
                >
                  {item.label}
                  <svg viewBox="0 0 24 24" class="chev size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div id="mega-servicios" data-dropdown-panel class="dropdown-panel absolute inset-x-5 top-full pt-3 sm:inset-x-8">
                  <div class="glass panel rounded-xl p-4">
                    <MegaMenuContent />
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={active(item.href) ? 'page' : undefined}
                  data-path={item.path}
                  class:list={['nav-link block rounded-md px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:text-text aria-[current=page]:text-text', item.path && 'path-link']}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="relative z-10 flex items-center gap-1 sm:gap-3">
      <div class="hidden items-center gap-1 font-mono text-xs sm:flex" aria-label="Idioma">
        <span class="px-1.5 py-1 text-text" aria-current="true">ES</span>
        <span class="text-text-muted">/</span>
        <span class="cursor-not-allowed px-1.5 py-1 text-text-muted opacity-70" aria-disabled="true" title="Próximamente">EN</span>
      </div>
      <ThemeToggle />
      <!-- Wrapper: los estilos con alcance de .btn (display) ganan a `hidden` de Tailwind si va en el propio Button -->
      <div class="hidden sm:block">
        <Button href={nav.cta.href} size="sm">{nav.cta.label}</Button>
      </div>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="flex size-11 items-center justify-center rounded-md text-text lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="ham ham-1" d="M4 7h16"></path>
          <path class="ham ham-2" d="M4 12h16"></path>
          <path class="ham ham-3" d="M4 17h16"></path>
        </svg>
      </button>
    </div>

    <MobileMenu lang={lang} />
  </div>
</header>

<style>
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    transition: opacity 0.25s ease;
  }
  .header[data-scrolled]::before {
    opacity: 1;
  }
  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }
  [data-dropdown][data-open] > .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel {
      transition: none;
    }
  }
  .chev {
    transition: transform 0.2s ease;
  }
  button[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  /* Subrayado con gradiente de camino */
  .path-link {
    position: relative;
  }
  .path-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .path-link[data-path='negocios']::after {
    background: var(--gradient-negocios);
  }
  .path-link[data-path='empresas']::after {
    background: var(--gradient-empresas);
  }
  .path-link:hover::after,
  .path-link:focus-visible::after,
  .path-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  /* Hamburguesa → X (solo CSS) */
  .ham {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.2s ease,
      opacity 0.15s ease;
  }
  [data-menu-toggle][aria-expanded='true'] .ham-1 {
    transform: translateY(5px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] .ham-2 {
    opacity: 0;
  }
  [data-menu-toggle][aria-expanded='true'] .ham-3 {
    transform: translateY(-5px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .ham {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/header';
  import '../../scripts/megamenu';
  import '../../scripts/mobile-menu';
</script>
