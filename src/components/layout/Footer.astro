---
import Logo from '../brand/Logo.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { company, whatsappUrl } from '../../data/company';
import { navigation, type Locale, type NavLink } from '../../data/navigation';

interface Props {
  lang?: Locale;
}
const { lang = 'es' } = Astro.props;
const { footer } = navigation[lang];
const year = new Date().getFullYear();
const linkClass = 'text-text-muted transition-colors hover:text-primary';
const columns: { id: string; title: string; items: NavLink[] }[] = [
  { id: 'servicios', title: 'Servicios', items: footer.services },
  { id: 'soluciones', title: 'Soluciones', items: footer.solutions },
  { id: 'empresa', title: 'Empresa', items: footer.company },
];
const titleClass = 'mb-4 font-mono text-xs tracking-[0.18em] text-text uppercase';
---

<footer class="border-t border-(--border) bg-bg-900">
  <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_3fr]">
      <div class="flex flex-col gap-5">
        <a href="/" aria-label="Vertex Quant Labs, inicio" class="w-fit"><Logo /></a>
        <p class="max-w-sm text-sm text-text-muted">{company.slogan}</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          columns.map((col) => (
            <nav aria-labelledby={`f-${col.id}`}>
              <h2 id={`f-${col.id}`} class={titleClass} style="font-stretch:100%;font-weight:500">{col.title}</h2>
              <ul class="flex flex-col gap-3 text-sm">
                {col.items.map((i) => (
                  <li class="flex flex-wrap items-center gap-2">
                    {i.soon ? <span class="text-text-muted">{i.label}</span> : <a href={i.href} class={linkClass}>{i.label}</a>}
                    {i.soon && <Badge variant="soon" />}
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
        <div>
          <h2 class={titleClass} style="font-stretch:100%;font-weight:500">Contacto</h2>
          <div class="flex flex-col items-start gap-4 text-sm">
            <Button href={whatsappUrl} target="_blank" rel="noopener noreferrer" variant="secondary" size="sm">
              WhatsApp {company.whatsapp.display}
            </Button>
            <p class="text-text-muted">{company.location}</p>
            <p class="text-text-muted">{company.markets}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-(--border) pt-6 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {company.name} · {company.slogan}</p>
      <ul class="flex gap-5">
        {footer.legal.map((i) => <li><a href={i.href} class={linkClass}>{i.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
