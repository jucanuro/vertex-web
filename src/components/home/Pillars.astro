---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import GlassCard from '../ui/GlassCard.astro';
import Icon from '../ui/Icon.astro';
import { pillars } from '../../data/pillars';
---

<Section bg="alt">
  <Reveal>
    <SectionHeading eyebrow="Nuestra forma de trabajar" title="Cuatro pilares" />
  </Reveal>
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {
      pillars.map((p, i) => (
        <li>
          <Reveal delay={i * 100} class="h-full">
            <GlassCard as="div" class="flex h-full flex-col gap-4">
              <div class="pointer-events-none absolute -top-10 -right-10 size-32 rounded-full bg-primary/10 blur-3xl" aria-hidden="true" />
              <span class="flex size-11 items-center justify-center rounded-lg border border-primary/30 bg-primary/10 text-primary">
                <Icon svg={p.icon} />
              </span>
              <h3 class="text-h3">{p.title}</h3>
              <p class="text-sm text-text-muted">{p.description}</p>
            </GlassCard>
          </Reveal>
        </li>
      ))
    }
  </ul>
</Section>
