---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import Badge from '../ui/Badge.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import ProductLogo from '../brand/ProductLogo.astro';
import { products } from '../../data/products';

const items = [
  { id: 'qhalisys' as const, p: products.qhalisys, badge: 'En operación' },
  { id: 'canchaya' as const, p: products.canchaya, badge: undefined },
];
---

<Section bg="alt">
  <Reveal>
    <SectionHeading eyebrow="Productos propios" title="Plataformas que creamos y operamos" />
  </Reveal>
  <div class="mt-12 flex flex-col gap-16 lg:gap-24">
    {
      items.map(({ id, p, badge }, i) => (
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
          <Reveal class:list={[i % 2 === 1 && 'lg:order-2']}>
            <div class="flex flex-col items-start gap-4">
              <ProductLogo product={id} variant="full" height={52} />
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-h2">{p.name}</h3>
                {badge && <Badge>{badge}</Badge>}
              </div>
              <p class="text-text-muted">{p.description}</p>
              <a href={p.slug} class="font-semibold text-primary underline-offset-4 hover:underline" aria-label={`Conocer ${p.name}`}>
                Conocer {p.name} →
              </a>
            </div>
          </Reveal>
          <Reveal delay={100}>
            <ImagePlaceholder ratio="16 / 10" label={`Espacio para captura: ${p.name}`} />
          </Reveal>
        </div>
      ))
    }
  </div>
</Section>
