---
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import GlassCard from '../ui/GlassCard.astro';
import { company, whatsappUrl } from '../../data/company';

interface Props {
  /** Nivel del título. El h1 debe ser único por página. */
  as?: 'h1' | 'h2';
  /** Sin alto de pantalla completa ni padding de header (para el sistema de diseño). */
  contained?: boolean;
}
const { as: Heading = 'h1', contained = false } = Astro.props;

type VerbKey = 'piensa' | 'protege' | 'escala';
const verbIcons: Record<VerbKey, string> = {
  piensa:
    '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>',
  protege: '<path d="M12 3 4.5 6v5.5c0 4.5 3 8 7.5 9.5 4.5-1.5 7.5-5 7.5-9.5V6L12 3z"/><path d="m9 12 2 2 4-4"/>',
  escala: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>',
};
const verbOrder: VerbKey[] = ['piensa', 'protege', 'escala'];
// El eslogan sale de company.slogan; los verbos se resaltan sin duplicar el texto
const parts = company.slogan.split(/(piensa|protege|escala)/);

const paths = [
  {
    href: '/negocios/',
    title: 'Tengo un negocio o emprendimiento',
    text: 'Sistemas listos para usar desde tu celular, con facturación electrónica.',
    accent: 'var(--verb-escala)',
    gradient: 'var(--gradient-negocios)',
  },
  {
    href: '/empresas/',
    title: 'Represento una empresa o institución',
    text: 'Software a medida, datos e IA aplicada, con diagnóstico previo.',
    accent: 'var(--verb-piensa)',
    gradient: 'var(--gradient-empresas)',
  },
];
---

<section data-hero class:list={['hero relative isolate overflow-hidden', !contained && 'hero--full']}>
  <!-- Capa 1: fondo CSS, siempre presente -->
  <div class="bg-aurora bg-aurora-verbs absolute inset-0" aria-hidden="true"></div>
  <div
    class="bg-grid absolute inset-0"
    style="mask-image:radial-gradient(ellipse at center,#000 20%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse at center,#000 20%,transparent 75%)"
    aria-hidden="true"
  >
  </div>

  <!-- El ruido va bajo el canvas: su mix-blend-mode no se recompone en cada frame de partículas -->
  <div class="noise" style="position:absolute;inset:0" aria-hidden="true"></div>

  <!-- Capa 2: isotipo estático (paths de public/brand/vertex-icon.svg) -->
  <svg
    data-vmark
    class="vmark absolute top-1/2 left-1/2"
    viewBox="0 10 230 210"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="hero-v-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--vmark-0)"></stop>
        <stop offset="0.5" style="stop-color:var(--vmark-1)"></stop>
        <stop offset="1" style="stop-color:var(--vmark-2)"></stop>
      </linearGradient>
    </defs>
    <g stroke="url(#hero-v-grad)" stroke-width="1" stroke-linejoin="round" vector-effect="non-scaling-stroke">
      <path vector-effect="non-scaling-stroke" d="M15 45 L62 45 L102 145 L120 100 L143 100 L96 205 Z"></path>
      <path vector-effect="non-scaling-stroke" d="M212 26 L150 110 L179 110 L128 196 L203 94 L174 94 Z"></path>
    </g>
  </svg>

  <!-- Capa 3: partículas (progresivas; se cargan solo en pantallas aptas) -->
  <canvas data-particles class="hero-canvas absolute inset-0 size-full" aria-hidden="true"></canvas>

  <!-- Velo para mantener el contraste del texto sobre las capas -->
  <div class="hero-veil absolute inset-0" aria-hidden="true"></div>

  <div class="hero-inner relative z-10 mx-auto flex w-full max-w-[1200px] flex-col items-center px-5 text-center sm:px-8">
    <Eyebrow>Casa matriz de desarrollo de software</Eyebrow>

    <Heading data-hero-title class="hero-title mt-6 text-balance">
      {
        parts.map((p) =>
          (verbOrder as string[]).includes(p) ? (
            <span class="verb" style={`--c:var(--verb-${p});--i:${verbOrder.indexOf(p as VerbKey)}`}>
              <span class="verb-ico">
                <Icon svg={verbIcons[p as VerbKey]} class="size-full" />
              </span>
              {p}
            </span>
          ) : (
            p
          ),
        )
      }
    </Heading>

    <p class="mt-6 max-w-2xl text-pretty text-text-muted">
      Software a medida, IA agéntica, datos y ciberseguridad para empresas en Perú y Latinoamérica.
    </p>

    <div class="mt-10 grid w-full max-w-4xl gap-4 text-left md:grid-cols-2 md:gap-6">
      {
        paths.map((p) => (
          <a href={p.href} class="path group" style={`--grad:${p.gradient};--accent:${p.accent}`}>
            <GlassCard accent={p.accent} class="h-full">
              <span class="flex h-full items-start justify-between gap-4">
                <span class="block">
                  <span class="font-display block text-xl font-bold leading-snug text-text">{p.title}</span>
                  <span class="mt-2 block text-[0.95rem] leading-relaxed text-text-muted">{p.text}</span>
                </span>
                <svg
                  class="arrow mt-1 size-6 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </GlassCard>
          </a>
        ))
      }
    </div>

    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="wa-link mt-8">
      ¿Prefieres conversar? <span>Escríbenos por WhatsApp</span>
    </a>
  </div>

  <span class="scroll-cue" aria-hidden="true"><span></span></span>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h) + 3rem) 0 var(--section-y-lg);
  }
  .hero--full {
    padding-block: calc(var(--header-h) + 3rem) var(--section-y-lg);
  }
  @media (min-width: 1024px) {
    .hero--full {
      min-height: 100svh;
    }
  }
  .hero:not(.hero--full) {
    padding-top: 4rem;
  }

  /* Isotipo: el tamaño se ajusta al alto del hero */
  .vmark {
    height: min(92%, 960px);
    width: auto;
    aspect-ratio: 230 / 210;
    max-width: 150vw;
    transform: translate(-50%, -50%);
    opacity: var(--vmark-o);
    filter: var(--vmark-filter);
    pointer-events: none;
  }

  .hero-canvas {
    opacity: 0;
    transition: opacity 1.4s ease;
    pointer-events: none;
  }
  .hero-canvas.is-on {
    opacity: 1;
  }
  /* Con el canvas activo la V estática se desvanece (solo opacity: sin saltos de layout).
     En escritorio se mantiene tal como estaba. */
  .vmark {
    transition: opacity 1.4s ease;
  }
  @media (max-width: 1023px) {
    .hero:has(.hero-canvas.is-on) .vmark {
      opacity: 0;
    }
  }

  .hero-veil {
    pointer-events: none;
    background: radial-gradient(ellipse 62% 55% at 50% 46%, var(--veil), transparent 78%);
  }

  @media (max-width: 479px) {
    .hero :global(.eyebrow) {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
    }
  }

  /* ── Titular: escala display, Archivo 800 expandido ── */
  .hero-title {
    font-size: clamp(2.75rem, 2rem + 4.44vw, 6rem);
    line-height: 1.02;
    max-width: 16ch;
  }
  @media (min-width: 640px) {
    .hero-title {
      max-width: 18ch;
    }
  }

  /* Los verbos se ven encendidos desde el primer render (estado base).
     Solo se animan color y text-shadow: nunca opacity ni transform del h1. */
  .verb {
    /* --verb-glow-k: 1 en oscuro (resplandor); 0.3 en claro (solo un leve text-shadow de color) */
    --glow: 0 0 0.4em color-mix(in srgb, var(--c) calc(50% * var(--verb-glow-k)), transparent);
    --glow-strong: 0 0 0.45em color-mix(in srgb, var(--c) calc(85% * var(--verb-glow-k)), transparent);
    color: var(--c);
    text-shadow: var(--glow);
    white-space: nowrap;
    animation:
      ignite 0.9s ease-out calc(0.4s + var(--i) * 0.6s) both,
      verb-cycle 12s ease-in-out calc(3.4s + var(--i) * 4s) infinite;
  }
  .verb-ico {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-inline-end: 0.08em;
    vertical-align: 0.08em;
    animation: ico-cycle 12s ease-in-out calc(3.4s + var(--i) * 4s) infinite;
  }
  @keyframes ignite {
    from {
      color: var(--c-text);
      text-shadow: 0 0 0 transparent;
    }
    45% {
      text-shadow: var(--glow-strong);
    }
    to {
      color: var(--c);
      text-shadow: var(--glow);
    }
  }
  @keyframes verb-cycle {
    0%,
    34%,
    100% {
      text-shadow: var(--glow);
    }
    8%,
    26% {
      text-shadow:
        0 0 0.5em color-mix(in srgb, var(--c) calc(95% * var(--verb-glow-k)), transparent),
        0 0 1.1em color-mix(in srgb, var(--c) calc(55% * var(--verb-glow-k)), transparent);
    }
  }
  @keyframes ico-cycle {
    0%,
    34%,
    100% {
      transform: scale(1);
    }
    8%,
    26% {
      transform: scale(1.18);
    }
  }

  /* ── Tarjetas de camino ── */
  .path {
    position: relative;
    display: block;
    border-radius: var(--radius-xl);
    transition: box-shadow 0.3s ease;
  }
  .path::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1px;
    background: var(--grad);
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.3s ease;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }
  .path:hover,
  .path:focus-visible {
    box-shadow: var(--glow-shape-lg) color-mix(in srgb, var(--accent) var(--glow-a-lg), transparent);
  }
  .path:hover::before,
  .path:focus-visible::before {
    opacity: 1;
  }
  .path:focus-visible {
    border-radius: var(--radius-xl);
    outline-offset: 4px;
  }
  .arrow {
    color: var(--accent);
    transition: transform 0.3s ease;
  }
  .path:hover .arrow,
  .path:focus-visible .arrow {
    transform: translateX(6px);
  }

  .wa-link {
    color: var(--c-text-muted);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .wa-link span {
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-text-muted) 50%, transparent);
    text-underline-offset: 4px;
  }
  .wa-link:hover span {
    text-decoration-color: currentColor;
  }

  /* ── Indicador de scroll ── */
  .scroll-cue {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero--full .scroll-cue {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      z-index: 10;
      display: block;
      width: 1.5rem;
      height: 2.4rem;
      margin-left: -0.75rem;
      border: 1.5px solid color-mix(in srgb, var(--c-text-muted) 50%, transparent);
      border-radius: 9999px;
    }
    .scroll-cue span {
      position: absolute;
      top: 0.45rem;
      left: 50%;
      width: 3px;
      height: 6px;
      margin-left: -1.5px;
      border-radius: 9999px;
      background: var(--c-primary);
      animation: cue 1.8s ease-in-out infinite;
    }
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70%,
    100% {
      transform: translateY(0.8rem);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      display: none !important;
    }
  }
</style>

<script>
  // Carga progresiva de las partículas: nunca bloquea el render ni el LCP.
  let stop: (() => void) | undefined;
  let gen = 0;

  /*
   * Degradación inteligente: si NO es apto, no se descarga el chunk y quedan el
   * fondo CSS y la V estática. Cómo simular cada caso en DevTools:
   *  - reduced-motion: Rendering > "Emulate CSS media feature prefers-reduced-motion".
   *  - saveData: Network conditions no lo ofrece; en consola, antes de recargar,
   *    Object.defineProperty(navigator.connection, 'saveData', { value: true }),
   *    o activa "Ahorro de datos" (Android) / extensión Chrome Data Saver.
   *  - 2g / slow-2g: Network > throttling "Slow 4G"/"3G" no cambia effectiveType a 2g;
   *    usa Object.defineProperty(navigator.connection, 'effectiveType', { value: '2g' }).
   *  - deviceMemory <= 2: Object.defineProperty(navigator, 'deviceMemory', { value: 2 }).
   *  - hardwareConcurrency <= 2: Sensors/Devtools "CPU cores" en Chrome
   *    (Rendering > "Hardware concurrency") o defineProperty(navigator, 'hardwareConcurrency', { value: 2 }).
   * Para que los defineProperty apliquen antes de `load`, ejecútalos en un Snippet con
   * "Pausar en el primer script" o recarga con la pestaña Sources > Overrides.
   * Comprobación: Network > JS no debe listar particles.*.js.
   */
  type Nav = Navigator & {
    connection?: { saveData?: boolean; effectiveType?: string };
    deviceMemory?: number;
  };
  function eligible(): boolean {
    const nav = navigator as Nav;
    const c = nav.connection;
    return !(
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      c?.saveData ||
      c?.effectiveType === '2g' ||
      c?.effectiveType === 'slow-2g' ||
      (nav.deviceMemory && nav.deviceMemory <= 2) ||
      (nav.hardwareConcurrency && nav.hardwareConcurrency <= 2)
    );
  }

  function boot() {
    stop?.();
    stop = undefined;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || !eligible()) return;
    const id = ++gen;
    const launch = () => {
      if (id !== gen || !hero.isConnected) return;
      import('../../scripts/particles').then(({ initParticles }) => {
        if (id !== gen || !hero.isConnected) return;
        stop = initParticles(hero);
      });
    };
    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(launch, { timeout: 2500 }) : setTimeout(launch, 300);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    gen++;
    stop?.();
    stop = undefined;
  });
</script>
