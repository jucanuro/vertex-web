---
import Section from '../ui/Section.astro';
import Reveal from '../ui/Reveal.astro';
import Button from '../ui/Button.astro';
import { whatsappUrl } from '../../data/company';
---

<Section bg="none">
  <Reveal>
    <div class="glow-border relative isolate overflow-hidden rounded-3xl bg-bg-900 px-6 py-14 text-center sm:px-12 sm:py-20">
      <div class="bg-aurora absolute inset-0 -z-10" aria-hidden="true"></div>
      <h2 class="text-h2 mx-auto max-w-3xl text-balance">¿Tu organización tiene un proceso por mejorar? Conversemos.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-text-muted text-balance">
        Agenda una reunión de diagnóstico sin costo y te enviamos una propuesta clara con alcance, plazo e inversión.
      </p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button href="/contacto/" variant="primary" size="lg">Agenda tu diagnóstico</Button>
        <Button href={whatsappUrl} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</Button>
      </div>
    </div>
  </Reveal>
</Section>
