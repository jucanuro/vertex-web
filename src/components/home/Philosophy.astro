---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { company } from '../../data/company';

const phrases = company.philosophy.split(/(?<=\.)\s+/);
const key = 'crecemos contigo';
---

<Section bg="aurora" size="lg" class="philosophy">
  <div class="bg-aurora bg-aurora-verbs absolute inset-0 -z-10 opacity-90" aria-hidden="true"></div>
  <div class="flex flex-col gap-8">
    <Eyebrow>Nuestra filosofía</Eyebrow>
    <h2 class="sr-only">Nuestra filosofía</h2>
    <blockquote class="quote max-w-4xl">
      {
        phrases.map((ph) => {
          const idx = ph.indexOf(key);
          return (
            <span class="phrase">
              {idx >= 0 ? (
                <>{ph.slice(0, idx)}<span class="text-gradient">{key}</span>{ph.slice(idx + key.length)}</>
              ) : (
                ph
              )}{' '}
            </span>
          );
        })
      }
    </blockquote>
  </div>
</Section>

<style>
  .quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 100%;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .phrase {
    display: block;
    margin-bottom: 0.9em;
  }
  /* Con scroll-driven animations cada frase se "enciende"; el texto siempre está en el HTML */
  @supports (animation-timeline: view()) {
    .phrase {
      animation: phrase-in linear both;
      animation-timeline: view();
      animation-range: entry 20% cover 45%;
    }
  }
  @keyframes phrase-in {
    from {
      opacity: 0.18;
    }
    to {
      opacity: 1;
    }
  }
</style>
