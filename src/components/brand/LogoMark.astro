---
/** Isotipo inline (paths de public/brand/vertex-logo-dark.svg) con ids de gradiente únicos. */
interface Props {
  uid: string;
  class?: string;
  /** Versión monocroma tenue (para placeholders) */
  muted?: boolean;
}
const { uid, class: className, muted = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="8 18 212 196"
  class={className}
  aria-hidden="true"
  focusable="false"
  style={muted ? 'opacity:.18' : undefined}
>
  <defs>
    <linearGradient id={`${uid}-v`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1F5FB8"></stop>
      <stop offset="0.55" stop-color="#1A86BF"></stop>
      <stop offset="1" stop-color="#26BFA8"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-b`} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5BF09A"></stop>
      <stop offset="1" stop-color="#1DBF7F"></stop>
    </linearGradient>
  </defs>
  <path d="M15 45 L62 45 L102 145 L120 100 L143 100 L96 205 Z" fill={`url(#${uid}-v)`}></path>
  <path d="M212 26 L150 110 L179 110 L128 196 L203 94 L174 94 Z" fill={`url(#${uid}-b)`}></path>
  <g class="nl" fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="32,112 68,80 98,116 132,70 150,48"></polyline>
    <line x1="98" y1="116" x2="98" y2="140"></line>
  </g>
  <g class="nd" stroke-width="5">
    <circle cx="32" cy="112" r="8"></circle>
    <circle cx="68" cy="80" r="7"></circle>
    <circle cx="98" cy="116" r="8"></circle>
    <circle cx="150" cy="48" r="8"></circle>
  </g>
</svg>

<style>
  /* Nodos del isotipo desde variables: oscuro (trazo claro, círculos oscuros) / claro (#0A2F63 y blanco) */
  .nl {
    stroke: var(--logo-node-stroke);
  }
  .nd {
    fill: var(--logo-node-fill);
    stroke: var(--logo-node-stroke);
  }
</style>
