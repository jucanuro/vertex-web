---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import Reveal from '../components/ui/Reveal.astro';
import ThemePanel from '../components/ui/ThemePanel.astro';
import Hero from '../components/home/Hero.astro';
import ProductLogo from '../components/brand/ProductLogo.astro';
import { clients } from '../data/clients';

---

<BaseLayout title="Sistema de diseño" description="Fundaciones visuales del sitio de Vertex Quant Labs." noindex>
  <Section bg="aurora" class="pt-(--header-h)">
    <SectionHeading as="h1" eyebrow="Sistema de diseño" title="Deep Navy + Quantum Glow" highlight="Quantum Glow" subtitle="Tokens, tipografía y componentes base en tema oscuro y claro. Página interna, no indexable." />
  </Section>

  <Section id="temas">
    <SectionHeading eyebrow="Temas" title="Oscuro y claro, lado a lado" subtitle="Cada columna fuerza su tema con data-theme; el botón del header cambia el tema del resto de la página." class="mb-10" />
    <div class="grid items-start gap-6 xl:grid-cols-2">
      <ThemePanel theme="dark" clients={clients} />
      <ThemePanel theme="light" clients={clients} />
    </div>
  </Section>

  <Section id="hero" bg="alt">
    <SectionHeading eyebrow="Home" title="Hero" subtitle="Versión contenida (sin alto de pantalla completa) con las tres capas de fondo y los dos caminos de entrada. Sigue el tema activo." class="mb-10" />
    <div class="overflow-hidden rounded-xl border border-(--border)">
      <Hero as="h2" contained />
    </div>
  </Section>

  <Section id="marcas-producto">
    <SectionHeading eyebrow="Marcas" title="Marcas de producto" subtitle="Logo completo e ícono de Qhalisys y Canchaya sobre fondo claro y oscuro." class="mb-10" />
    <div class="grid gap-6 md:grid-cols-2">
      {
        (['light', 'dark'] as const).map((t) => (
          <div data-theme={t} class="flex flex-col gap-6 rounded-2xl border border-border p-6" style="background:var(--c-bg);color:var(--c-text-muted)">
            <p class="font-mono text-xs">Fondo {t === 'light' ? 'claro' : 'oscuro'}</p>
            {(['qhalisys', 'canchaya'] as const).map((id) => (
              <div class="flex flex-wrap items-center gap-6">
                <ProductLogo product={id} variant="full" height={48} />
                <ProductLogo product={id} variant="icon" height={48} />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </Section>

  <Section bg="aurora" id="reveal">
    <SectionHeading eyebrow="Movimiento" title="Reveal escalonado" subtitle="Desplázate para ver la aparición con retraso incremental." class="mb-10" />
    <div class="grid gap-5 sm:grid-cols-3">
      {
        [0, 1, 2].map((i) => (
          <Reveal delay={i * 120}>
            <GlassCard>
              <p class="font-mono text-xs text-text-muted">delay {i * 120}ms</p>
              <h3 class="text-h3 mt-2">Elemento {i + 1}</h3>
            </GlassCard>
          </Reveal>
        ))
      }
    </div>
    <div class="glow-border mt-10 rounded-xl p-6">
      <p class="font-mono text-sm">.glow-border · <span class="noise inline-block">.noise</span></p>
    </div>
  </Section>
</BaseLayout>
